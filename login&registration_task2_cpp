static inline uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }

Bytes sha256(const Bytes& data) {
    uint32_t h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                     0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
    Bytes msg = data;
    msg.push_back(0x80);
    while (msg.size() % 64 != 56) msg.push_back(0);
    uint64_t bits = static_cast<uint64_t>(data.size()) * 8;
    for (int i = 7; i >= 0; --i) msg.push_back(static_cast<uint8_t>(bits >> (8 * i)));

    for (size_t off = 0; off < msg.size(); off += 64) {
        uint32_t w[64];
        for (int i = 0; i < 16; ++i)
            w[i] = (uint32_t(msg[off + 4 * i]) << 24) | (uint32_t(msg[off + 4 * i + 1]) << 16) |
                   (uint32_t(msg[off + 4 * i + 2]) << 8) | uint32_t(msg[off + 4 * i + 3]);
        for (int i = 16; i < 64; ++i) {
            uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
            uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
        for (int i = 0; i < 64; ++i) {
            uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            uint32_t ch = (e & f) ^ (~e & g);
            uint32_t t1 = hh + S1 + ch + K256[i] + w[i];
            uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
            uint32_t t2 = S0 + maj;
            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        h[0] += a; h[1] += b; h[2] += c; h[3] += d;
        h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
    }
    Bytes out;
    for (uint32_t v : h)
        for (int i = 3; i >= 0; --i) out.push_back(static_cast<uint8_t>(v >> (8 * i)));
    return out;
}

Bytes hmacSha256(Bytes key, const Bytes& msg) {
    if (key.size() > 64) key = sha256(key);
    key.resize(64, 0);
    Bytes inner(64), outer(64);
    for (int i = 0; i < 64; ++i) { inner[i] = key[i] ^ 0x36; outer[i] = key[i] ^ 0x5c; }
    inner.insert(inner.end(), msg.begin(), msg.end());
    Bytes ih = sha256(inner);
    outer.insert(outer.end(), ih.begin(), ih.end());
    return sha256(outer);
}


Bytes pbkdf2(const string& password, const Bytes& salt, uint32_t iterations) {
    Bytes key(password.begin(), password.end());
    Bytes first = salt;
    first.insert(first.end(), {0, 0, 0, 1});
    Bytes u = hmacSha256(key, first);
    Bytes t = u;
    for (uint32_t i = 1; i < iterations; ++i) {
        u = hmacSha256(key, u);
        for (size_t j = 0; j < t.size(); ++j) t[j] ^= u[j];
    }
    return t;
}


const uint32_t ITERATIONS = 100000;
const char* USER_DIR = "users";

string toHex(const Bytes& b) {
    static const char* d = "0123456789abcdef";
    string s;
    for (uint8_t v : b) { s += d[v >> 4]; s += d[v & 15]; }
    return s;
}

optional<Bytes> fromHex(const string& s) {
    if (s.size() % 2) return nullopt;
    Bytes out;
    for (size_t i = 0; i < s.size(); i += 2) {
        if (!isxdigit(static_cast<unsigned char>(s[i])) || !isxdigit(static_cast<unsigned char>(s[i + 1])))
            return nullopt;
        out.push_back(static_cast<uint8_t>(stoi(s.substr(i, 2), nullptr, 16)));
    }
    return out;
}

Bytes randomBytes(size_t n) {
    Bytes out(n);
    ifstream ur("/dev/urandom", ios::binary);
    if (ur && ur.read(reinterpret_cast<char*>(out.data()), static_cast<streamsize>(n))) return out;
    random_device rd;  // fallback (e.g. Windows)
    for (auto& b : out) b = static_cast<uint8_t>(rd());
    return out;
}


bool constantTimeEqual(const Bytes& a, const Bytes& b) {
    if (a.size() != b.size()) return false;
    uint8_t diff = 0;
    for (size_t i = 0; i < a.size(); ++i) diff |= a[i] ^ b[i];
    return diff == 0;
}

string lower(string s) {
    transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return tolower(c); });
    return s;
}

fs::path userFile(const string& username) { return fs::path(USER_DIR) / (lower(username) + ".dat"); }


optional<string> validateUsername(const string& u) {
    if (u.size() < 3 || u.size() > 20) return "Username must be 3-20 characters long.";
    for (unsigned char c : u)
        if (!isalnum(c) && c != '_') return "Username may contain only letters, digits and underscore.";
    return nullopt;
}

optional<string> validatePassword(const string& p, const string& username) {
    if (p.size() < 8) return "Password must be at least 8 characters long.";
    if (p.size() > 128) return "Password must be at most 128 characters long.";
    bool letter = false, digit = false;
    for (unsigned char c : p) { letter |= isalpha(c) != 0; digit |= isdigit(c) != 0; }
    if (!letter || !digit) return "Password must contain at least one letter and one digit.";
    if (lower(p) == lower(username)) return "Password must not be the same as the username.";
    return nullopt;
}


struct Result { bool ok; string message; };

Result registerUser(const string& username, const string& password) {
    if (auto err = validateUsername(username)) return {false, *err};
    if (auto err = validatePassword(password, username)) return {false, *err};

    error_code ec;
    fs::create_directories(USER_DIR, ec);
    if (ec) return {false, "Could not create storage directory: " + ec.message()};

    fs::path file = userFile(username);
    if (fs::exists(file)) return {false, "Username already taken. Please choose another."};

    Bytes salt = randomBytes(16);
    Bytes hash = pbkdf2(password, salt, ITERATIONS);

    ofstream out(file, ios::trunc);
    if (!out) return {false, "Could not save your account."};
    out << "v1$" << ITERATIONS << "$" << toHex(salt) << "$" << toHex(hash) << "\n";
    out.close();
    if (!out) return {false, "Could not save your account."};

    // Owner read/write only (no effect on Windows).
    fs::permissions(file, fs::perms::owner_read | fs::perms::owner_write, fs::perm_options::replace, ec);
    return {true, "Registration successful. You can now log in."};
}

Result loginUser(const string& username, const string& password) {
    const Result bad{false, "Invalid username or password."};

    fs::path file;
    bool known = !validateUsername(username).has_value();
    string line;
    if (known) {
        file = userFile(username);
        ifstream in(file);
        if (in) getline(in, line);
    }


    Bytes salt = randomBytes(16);
    Bytes expected(32, 0);
    uint32_t iters = ITERATIONS;
    bool parsed = false;

    if (!line.empty()) {
        vector<string> parts;
        stringstream ss(line);
        string tok;
        while (getline(ss, tok, '$')) parts.push_back(tok);
        if (parts.size() == 4 && parts[0] == "v1") {
            auto s = fromHex(parts[2]);
            auto h = fromHex(parts[3]);
            try {
                unsigned long it = stoul(parts[1]);
                if (s && h && h->size() == 32 && it > 0 && it <= 10000000) {
                    salt = *s; expected = *h; iters = static_cast<uint32_t>(it); parsed = true;
                }
            } catch (...) {}
        }
    }

    Bytes actual = pbkdf2(password, salt, iters);
    bool match = constantTimeEqual(actual, expected);
    if (!parsed || !match) return bad;
    return {true, "Login successful. Welcome, " + username + "!"};
}

string readLine(const string& prompt) {
    cout << prompt << flush;
    string s;
    if (!getline(cin, s)) { cout << "\nInput ended. Goodbye.\n"; exit(0); }
    return s;
}

string readPassword(const string& prompt) {
    cout << prompt << flush;
    string s;
#ifdef _WIN32
    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
    DWORD mode = 0;
    bool tty = GetConsoleMode(h, &mode) != 0;
    if (tty) SetConsoleMode(h, mode & ~ENABLE_ECHO_INPUT);
    bool ok = static_cast<bool>(getline(cin, s));
    if (tty) { SetConsoleMode(h, mode); cout << "\n"; }
#else
    termios oldt{};
    bool tty = isatty(STDIN_FILENO) && tcgetattr(STDIN_FILENO, &oldt) == 0;
    if (tty) {
        termios newt = oldt;
        newt.c_lflag &= ~static_cast<tcflag_t>(ECHO);
        tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    }
    bool ok = static_cast<bool>(getline(cin, s));
    if (tty) { tcsetattr(STDIN_FILENO, TCSANOW, &oldt); cout << "\n"; }
#endif
    if (!ok) { cout << "\nInput ended. Goodbye.\n"; exit(0); }
    return s;
}

void doRegister() {
    cout << "\n--- Register ---\n";
    string u = readLine("Username: ");
    string p = readPassword("Password: ");
    string c = readPassword("Confirm password: ");
    if (p != c) { cout << "Error: passwords do not match.\n"; return; }
    Result r = registerUser(u, p);
    cout << (r.ok ? "Success: " : "Error: ") << r.message << "\n";
}

void doLogin() {
    cout << "\n--- Login ---\n";
    const int MAX_ATTEMPTS = 3;
    for (int attempt = 1; attempt <= MAX_ATTEMPTS; ++attempt) {
        string u = readLine("Username: ");
        string p = readPassword("Password: ");
        Result r = loginUser(u, p);
        if (r.ok) { cout << "Success: " << r.message << "\n"; return; }
        cout << "Error: " << r.message << " (" << (MAX_ATTEMPTS - attempt) << " attempts left)\n";
    }
    cout << "Too many failed attempts. Returning to the main menu.\n";
}


int selfTest() {
    string s = "salt";
    Bytes salt(s.begin(), s.end());
    bool a = toHex(pbkdf2("password", salt, 1)) ==
             "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b";
    bool b = toHex(pbkdf2("password", salt, 2)) ==
             "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43";
    bool c = toHex(sha256(Bytes{'a', 'b', 'c'})) ==
             "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    cout << "SHA-256 abc:          " << (c ? "PASS" : "FAIL") << "\n";
    cout << "PBKDF2 1 iteration:   " << (a ? "PASS" : "FAIL") << "\n";
    cout << "PBKDF2 2 iterations:  " << (b ? "PASS" : "FAIL") << "\n";
    return (a && b && c) ? 0 : 1;
}

int main(int argc, char** argv) {
    if (argc > 1 && string(argv[1]) == "--selftest") return selfTest();

    while (true) {
        cout << "\n=== LOGIN SYSTEM ===\n1. Register\n2. Login\n3. Exit\n";
        string choice = readLine("Choose an option: ");
        if (choice == "1") doRegister();
        else if (choice == "2") doLogin();
        else if (choice == "3") { cout << "Goodbye.\n"; return 0; }
        else cout << "Error: please enter 1, 2 or 3.\n";
    }
}
